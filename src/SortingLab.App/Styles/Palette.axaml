<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="SystemAccentColor">#2563EB</Color>
  <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
  <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
  <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
  <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
  <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
  <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>

  <Color x:Key="AppBackgroundColor">#F5F7FA</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceSubtleColor">#F8FAFC</Color>
  <Color x:Key="SurfaceHoverColor">#F1F5F9</Color>
  <Color x:Key="BorderColor">#E2E8F0</Color>
  <Color x:Key="BorderStrongColor">#CBD5E1</Color>
  <Color x:Key="TextPrimaryColor">#0F172A</Color>
  <Color x:Key="TextSecondaryColor">#475569</Color>
  <Color x:Key="TextMutedColor">#64748B</Color>
  <Color x:Key="AccentColor">#2563EB</Color>
  <Color x:Key="AccentSoftColor">#EFF6FF</Color>
  <Color x:Key="AccentBorderColor">#BFDBFE</Color>
  <Color x:Key="SuccessColor">#0F766E</Color>
  <Color x:Key="SuccessSoftColor">#F0FDFA</Color>
  <Color x:Key="WarningColor">#B45309</Color>
  <Color x:Key="WarningSoftColor">#FFFBEB</Color>
  <Color x:Key="DangerColor">#B91C1C</Color>
  <Color x:Key="DangerSoftColor">#FEF2F2</Color>
  <Color x:Key="DangerBorderColor">#FECACA</Color>
  <Color x:Key="CompareColor">#D97706</Color>
  <Color x:Key="CompareSoftColor">#FFFBEB</Color>

  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource SystemAccentColorLight1}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
  <SolidColorBrush x:Key="CompareBrush" Color="{StaticResource CompareColor}" />
  <SolidColorBrush x:Key="CompareSoftBrush" Color="{StaticResource CompareSoftColor}" />

  <FontFamily x:Key="AppFont">Segoe UI, Inter, sans-serif</FontFamily>
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
  <Thickness x:Key="PagePadding">28,24,28,24</Thickness>
</ResourceDictionary>
