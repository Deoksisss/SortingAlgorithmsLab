<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SortingLab.App.Views.Controls.PlaybackPanel">
  <Border Classes="card" Padding="16">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
        <Border Classes="stateBadge"
                Classes.running="{Binding IsRunning}"
                Classes.paused="{Binding IsPaused}"
                Classes.completed="{Binding IsCompleted}"
                Classes.cancelled="{Binding IsCancelled}"
                Classes.faulted="{Binding IsFaulted}"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding StateText}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>

        <TextBlock Grid.Column="1"
                   Text="{Binding StepText}"
                   Classes="caption"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="Задержка" Classes="caption" VerticalAlignment="Center" />
          <Slider Width="170"
                  Minimum="0"
                  Maximum="1000"
                  TickFrequency="10"
                  IsSnapToTickEnabled="True"
                  Value="{Binding StepDelayMilliseconds}" />
          <TextBlock Text="{Binding DelayText}"
                     Classes="caption"
                     VerticalAlignment="Center"
                     MinWidth="52" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
          <Button Content="Запустить"
                  Classes="primary"
                  Command="{Binding StartCommand}"
                  ToolTip.Tip="Запустить демонстрацию с автоматическим переходом" />
          <Button Content="Пауза"
                  Command="{Binding PauseCommand}"
                  ToolTip.Tip="Приостановить демонстрацию" />
          <Button Content="Продолжить"
                  Command="{Binding ResumeCommand}"
                  ToolTip.Tip="Продолжить с текущего шага" />
          <Button Content="Шаг"
                  Command="{Binding StepCommand}"
                  ToolTip.Tip="Выполнить ровно одну операцию" />
          <Button Content="Остановить"
                  Classes="danger"
                  Command="{Binding StopCommand}"
                  ToolTip.Tip="Отменить выполнение алгоритма" />
          <Button Content="Сброс"
                  Classes="ghost"
                  Command="{Binding ResetCommand}"
                  ToolTip.Tip="Очистить журнал и вернуть исходные данные" />
        </WrapPanel>

        <ProgressBar Grid.Column="1"
                     Width="150"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsActive}"
                     VerticalAlignment="Center" />
      </Grid>

      <Border Classes="errorBanner" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}"
                   Classes="dangerText"
                   FontSize="12" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
