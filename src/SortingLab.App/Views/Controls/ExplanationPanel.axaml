<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SortingLab.App.Views.Controls.ExplanationPanel"
             x:Name="Root">
  <Border Classes="card">
    <StackPanel Spacing="9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Что происходит сейчас" Classes="h3" />
        <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
          <TextBlock Text="{Binding Kind, ElementName=Root}" Classes="caption" />
        </Border>
      </Grid>
      <TextBlock Text="{Binding Title, ElementName=Root}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource AccentBrush}" />
      <SelectableTextBlock Text="{Binding Explanation, ElementName=Root}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
  </Border>
</UserControl>
