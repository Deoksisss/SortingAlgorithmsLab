<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SortingLab.App.Views.Controls.StatTile"
             x:Name="Root">
  <Border Classes="statTile">
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding Label, ElementName=Root}" Classes="caption" />
      <TextBlock Text="{Binding Value, ElementName=Root}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Border>
</UserControl>
