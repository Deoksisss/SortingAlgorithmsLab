<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SortingLab.App.ViewModels.Sections"
             xmlns:views="using:SortingLab.App.Views.Sections"
             xmlns:converters="using:SortingLab.App.Converters"
             x:Class="SortingLab.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SortingLab.App/Styles/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:HighlightBrushConverter x:Key="HighlightBrush" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://SortingLab.App/Styles/Theme.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:InternalSortViewModel}">
      <views:InternalSortView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExternalSortViewModel}">
      <views:ExternalSortView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TextSortViewModel}">
      <views:TextSortView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
